PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/car2go
CLIENT_ORIGIN=http://localhost:4200
HTTP_LOGS=false

# Required: use a long random value in real environments
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=car2go_auth

# Required for Razorpay checkout
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# Optional override
DATA_SEED_ADMIN_EMAIL=admin@car2go.com

# Required and must be strong: 8+ chars with upper, lower, number, special
DATA_SEED_ADMIN_PASSWORD=ReplaceWithStrongAdminPassword@123
